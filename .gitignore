# =========================
# OS / editor clutter
# =========================
.DS_Store
Thumbs.db

.vscode/
.idea/

# =========================
# Python bytecode / caches
# =========================
__pycache__/
*.py[cod]
*$py.class

# Common tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# scikit-learn / joblib caches (matches your ".sk_cache")
.sk_cache/
joblib_cache/
**/.sk_cache/

# =========================
# Environments
# =========================
.venv/
venv/
env/
ENV/
.conda/
conda-env/

# =========================
# Logs / temporary files
# =========================
*.log
logs/
tmp/
temp/

# =========================
# Local config / secrets
# =========================
.env
.env.*
# If server_config.py is machine-specific (paths, tokens), don't version it:
server_config.py

# Tip: commit a template instead:
!server_config.example.py

# =========================
# Data (avoid committing real patient/therapist data)
# =========================
patient_data.csv
therapist_data.csv

# If you later move data into a folder, ignore the whole folder:
data/
raw_data/
processed_data/

# Allow tiny example data / schemas if you want them in the repo:
!data/README.md
!data/example_*.csv

# =========================
# Model outputs / artifacts
# =========================
model_outputs/
outputs/
runs/
artifacts/

# Common ML artifacts (put these under model_outputs/ ideally)
*.pkl
*.pickle
*.joblib
*.sav
*.pt
*.pth
*.onnx

# Large arrays / tables (optional; enable if these are generated, not source-of-truth)
*.npy
*.npz
*.parquet
*.feather
*.docx

# Keep a placeholder readme if you want the folder visible in git
!model_outputs/README.md

